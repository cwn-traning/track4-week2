{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "dag-planner/blocks@1",
 "title": "dag-planner blocks.json",
 "type": "object",
 "required": ["blocks"],
 "properties": {
  "goal": {"type": "string"},
  "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,63}$"},
  "blocks": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "title", "size", "skill", "difficulty", "output", "done"],
    "properties": {
     "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,59}$"},
     "title": {"type": "string", "minLength": 1},
     "size": {"enum": ["S", "M", "L"]},
     "depends_on": {"type": "array", "items": {"type": "string"}},
     "skill": {"enum": ["yolo", "cyolo", "image", "review", "debate", "best_of"]},
     "difficulty": {"type": "integer", "minimum": 1, "maximum": 6},
     "output": {"type": "string", "minLength": 1},
     "done": {"type": "string", "minLength": 1},
     "exclusive": {"type": "boolean"},
     "n": {"type": "integer", "minimum": 2, "maximum": 4}
    }
   }
  }
 }
}
